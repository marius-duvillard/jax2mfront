# Exclude castem, include and src directories
**/include/
**/src/
**/castem

# Exclude folders starting with cppflow and libtensorflow
cppflow*/
libtensorflow*/

# Python cache and type hints
__pycache__/
.mypy_cache/

# Optional: Ignore temporary files
*.pyc
*.pyo
*.pyd
*.swp
*.DS_Store

# images
*.png

# result files
*.result

# Environment
*.venv

