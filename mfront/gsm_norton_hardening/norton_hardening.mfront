@DSL Implicit;

@Behaviour NortonHardening;
@Author Thomas Helfer;
@Date 02 / 02 / 2026;
@Description {
}
@Profiling true; 
@Algorithm NewtonRaphson;
@Epsilon 1.e-14;
@Theta 1.;
@AuxiliaryStateVariable real niter;

@Brick StandardElastoViscoPlasticity{
  stress_potential : "Hooke" {
    young_modulus : 150e9, // the Young's modulus of an isotropic material
    poisson_ratio : 0.3
  },
  inelastic_flow : "Norton" {
    criterion : "Mises",
    isotropic_hardening : "Voce" {R0 : 15e6, Rinf : 100e6, b : 20},
    A : 8e-67,
    K : 1,
    n : 8.2
  }
};

@Integrator{
    ++niter;
}